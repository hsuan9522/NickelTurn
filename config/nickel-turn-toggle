#!/bin/sh

ready_file=/mnt/onboard/.adds/nickel-turn/ready
plugin_file=/usr/local/Kobo/imageformats/libnickelturn.so

[ -f "$plugin_file" ] || exit 1

# The NickelMenu config may become available before NickelTurn finishes init.
# Wait briefly for a ready marker belonging to this Nickel process.
i=0
while [ "$i" -lt 5 ]; do
    pid=$(pidof nickel)
    if [ -n "$pid" ]; then
        ready_pid=$(cat "$ready_file" 2>/dev/null)
        if [ "$ready_pid" = "$pid" ]; then
            kill -USR1 "$pid"
            exit $?
        fi
    fi
    sleep 1
    i=$((i + 1))
done

exit 1
